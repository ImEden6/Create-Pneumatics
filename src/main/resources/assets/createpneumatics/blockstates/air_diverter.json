{
  "multipart": [
    {
      "apply": {
        "model": "createpneumatics:block/diverter_body"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "createpneumatics:block/tube_arm"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "createpneumatics:block/tube_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "createpneumatics:block/tube_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "createpneumatics:block/tube_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "createpneumatics:block/tube_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "createpneumatics:block/tube_arm",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "north",
        "powered": "true"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap_shut"
      }
    },
    {
      "when": {
        "facing": "north",
        "powered": "false"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap"
      }
    },
    {
      "when": {
        "facing": "east",
        "powered": "true"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap_shut",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "powered": "false"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "powered": "true"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap_shut",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "powered": "false"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "powered": "true"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap_shut",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "powered": "false"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "powered": "true"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap_shut",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "powered": "false"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "down",
        "powered": "true"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap_shut",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "down",
        "powered": "false"
      },
      "apply": {
        "model": "createpneumatics:block/diverter_flap",
        "x": 90
      }
    }
  ]
}
